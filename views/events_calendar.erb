<% @month_grids.each do |month| %>
  <div class="cal-scroll">
    <table class="cal-month">
      <caption class="cal-month-title"><%= month.title %></caption>
      <thead>
        <tr>
          <% %w[Mon Tue Wed Thu Fri Sat Sun].each do |day| %>
            <th scope="col"><%= day %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% month.weeks.each do |week| %>
          <tr>
            <% week.each do |cell| %>
              <% if cell.date.nil? %>
                <td class="cal-day cal-day-blank"></td>
              <% else %>
                <td class="cal-day<%= " cal-today" if cell.today %>">
                  <span class="cal-day-num"><%= cell.date.day %></span>
                  <% cell.spans.each do |span| %>
                    <% if span.nil? %>
                      <p class="cal-span cal-span-spacer" aria-hidden="true">&nbsp;</p>
                    <% elsif span.label %>
                      <p class="<%= span.css_classes %>" style="--span-days: <%= span.days %>; --event-color: <%= source_color(span.event) %>">
                        <%== erb :events_calendar_link, layout: false, locals: { event: span.event } %>
                      </p>
                    <% else %>
                      <p class="<%= span.css_classes %>" style="--event-color: <%= source_color(span.event) %>" aria-hidden="true">&nbsp;</p>
                    <% end %>
                  <% end %>
                  <% cell.visible_events.each do |event| %>
                    <p class="cal-event" style="--event-color: <%= source_color(event) %>">
                      <% if (time = event.formatted_time) %><span class="cal-event-time"><%= time %></span><% end %>
                      <%== erb :events_calendar_link, layout: false, locals: { event: event } %>
                    </p>
                  <% end %>
                  <% if cell.overflow_count.positive? %>
                    <p class="cal-more"><a href="<%= @filter.view_url("list") %>">+<%= cell.overflow_count %> more</a></p>
                  <% end %>
                </td>
              <% end %>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
