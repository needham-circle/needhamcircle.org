#!/usr/bin/env ruby

$:.unshift File.expand_path(File.join("..", "lib"), __dir__)
require "logger"
require "needham_circle"
require "irb"

module NeedhamCircle
  module IRBHelpers
    def secrets
      Env.secrets
    end

    def calendar
      GoogleCalendar.new(secrets.fetch("SERVICE_ACCOUNT_KEY"))
    end

    # A ready-to-use fetcher per source (e.g. `lwv.fetch_events` in the REPL),
    # generated from the registered fetchers so a new source needs no edit here.
    Sync.fetchers.each do |fetcher|
      define_method(Sync.name_for(fetcher)) { fetcher.new(logger: Logger.new($stdout)) }
    end
  end
end

extend NeedhamCircle::IRBHelpers
IRB.start
