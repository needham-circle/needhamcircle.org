<h2 class="visually-hidden">Upcoming Events</h2>

<div class="event-filters" data-filters>
  <div class="filter-bar">
    <form class="filter-search-form" method="get" action="/events">
      <% unless @filter.coerced_for(:source).empty? %>
        <input type="hidden" name="source" value="<%= @filter.coerced_for(:source).join(",") %>">
      <% end %>
      <% if @filter.view == "calendar" %>
        <input type="hidden" name="view" value="calendar">
      <% end %>
      <input
        class="filter-search"
        type="search"
        name="q"
        placeholder="Search events"
        aria-label="Search events"
        value="<%= @filter.query %>"
        data-search
      >
    </form>

    <details class="source-filter" data-source-filter>
      <summary class="source-filter-trigger">
        Organizations<span class="source-filter-count" data-source-count<%= " hidden" if @filter.selected_sources_size.zero? %>><%= @filter.selected_sources_size %></span>
        <span class="source-filter-caret" aria-hidden="true"></span>
      </summary>
      <div class="source-filter-menu">
        <ul class="source-filter-list">
          <% @filter.sources.each do |source| %>
            <% active = @filter.coerced_for(:source).include?(source.slug) %>
            <li>
              <a
                class="source-option"
                href="<%= @filter.toggle_url(source.slug) %>"
                data-source="<%= source.slug %>"
                data-label="<%= source.label %>"
                role="checkbox"
                aria-checked="<%= active %>"
              ><span class="source-swatch" style="--event-color: <%= source.color %>" aria-hidden="true"></span><%= source.label %></a>
            </li>
          <% end %>
        </ul>
        <div class="source-filter-actions">
          <a href="<%= @filter.select_all_url %>" data-select-all>Select all</a>
          <a href="<%= @filter.clear_sources_url %>" data-clear-sources>Clear</a>
        </div>
      </div>
    </details>

    <div class="view-toggle" data-view-toggle role="group" aria-label="Events view">
      <% [["list", "List"], ["calendar", "Calendar"]].each do |view, label| %>
        <a
          class="view-option"
          href="<%= @filter.view_url(view) %>"
          data-view="<%= view %>"
          aria-current="<%= @filter.view == view %>"
        ><%= label %></a>
      <% end %>
    </div>
  </div>

  <div class="applied-filters" data-applied<%= " hidden" if @filter.selected_sources_size.zero? %>>
    <% @filter.selected_sources.each do |source| %>
      <a
        class="applied-chip"
        href="<%= @filter.toggle_url(source.slug) %>"
        data-source="<%= source.slug %>"
        aria-label="Remove <%= source.label %> filter"
      ><%= source.label %><span class="applied-chip-x" aria-hidden="true">&times;</span></a>
    <% end %>
  </div>
</div>

<div data-events>
  <%== erb :events, layout: false %>
</div>

<template data-error>
  <p class="empty-state">We're having trouble loading events right now. Please check back soon.</p>
</template>

<template data-skeleton="list">
  <div class="events-skeleton" aria-hidden="true">
    <div class="skeleton-month"></div>
    <% 4.times do %>
      <div class="skeleton-event">
        <span class="skeleton-line skeleton-time"></span>
        <span class="skeleton-line skeleton-title"></span>
        <span class="skeleton-line skeleton-loc"></span>
      </div>
    <% end %>
  </div>
</template>

<template data-skeleton="calendar">
  <div class="cal-scroll" aria-hidden="true">
    <table class="cal-month">
      <caption class="cal-month-title"><span class="skeleton-line skeleton-cal-title"></span></caption>
      <thead>
        <tr>
          <% 7.times do %>
            <th scope="col"><span class="skeleton-line skeleton-cal-head"></span></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% 5.times do %>
          <tr>
            <% 7.times do %>
              <td class="cal-day"><span class="skeleton-line skeleton-cal-num"></span></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</template>

<script src="/filters.js" defer></script>
